{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "Mode": "Local",
    "LocalConfig": {
      "TaskFilePath": "./tasks",
      "ResultOutputPath": "./results",
      "OutputFormat": "csv",
      "MaxConcurrentTasks": 5
    },
    "ServerConfig": {
      "ServerUrl": "http://localhost:5000",
      "AgentId": "agent-001",
      "AgentName": "Agent 001",
      "AgentToken": "",
      "HeartbeatInterval": 30,
      "EncryptionKey": "",
      "MaxConcurrentTasks": 5,
      "OfflineSyncIntervalMinutes": 5
    },
    "OfflineStorage": {
      "OfflineResultsPath": "./offline_results",
      "CheckpointsPath": "./checkpoints"
    }
  },
  "Downloader": {
    "ConnectionTimeout": 30,
    "RequestTimeout": 60,
    "MaxConcurrentRequests": 10,
    "RetryCount": 3,
    "RetryDelayMs": 1000
  },
  "Playwright": {
    "BrowserType": "Chromium",
    "Headless": true,
    "ViewportWidth": 1920,
    "ViewportHeight": 1080,
    "Timeout": 30000,
    "WaitUntil": "NetworkIdle",
    "MaxInstances": 5,
    "MaxLifetimeMinutes": 30
  }
}
