@page "/overview"

<PageTitle>系统概览 - ResourceSpider</PageTitle>

<h1>系统概览</h1>

<div class="card-grid">
    <section class="card api-card">
        <div class="card-icon">🔑</div>
        <h2>管理端 API</h2>
        <p>后台管理：<code>/api/admin/*</code></p>
        <p>后台登录：<code>/api/admin/auth/login</code></p>
    </section>
    
    <section class="card api-card">
        <div class="card-icon">🌐</div>
        <h2>Agent 通讯 API</h2>
        <p>节点通讯：<code>/api/agent/*</code></p>
        <p>任务拉取与结果上报：<code>/api/agent/tasks/*</code>、<code>/api/agent/results/*</code></p>
    </section>
    
    <section class="card api-card">
        <div class="card-icon">🛠️</div>
        <h2>运维入口</h2>
        <p>Swagger：<code>/swagger</code></p>
        <p>健康检查：<code>/health</code></p>
    </section>
</div>

<div class="card runtime-section">
    <h2>快速链接</h2>
    <div class="quick-links">
        <a class="quick-link" href="/swagger" target="_blank">
            <span class="quick-link-icon">📚</span>
            <div class="quick-link-content">
                <strong>API 文档</strong>
                <span>查看完整的 API 接口文档</span>
            </div>
        </a>
        <a class="quick-link" href="/health" target="_blank">
            <span class="quick-link-icon">💚</span>
            <div class="quick-link-content">
                <strong>健康检查</strong>
                <span>查看系统健康状态</span>
            </div>
        </a>
        <a class="quick-link" href="/admin">
            <span class="quick-link-icon">⚙️</span>
            <div class="quick-link-content">
                <strong>后台管理</strong>
                <span>进入后台管理系统</span>
            </div>
        </a>
    </div>
</div>
