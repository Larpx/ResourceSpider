@page "/admin/agents"
@layout AdminLayout
@inject AdminSessionState Session
@inject AdminApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Agent 配置 - ResourceSpider</PageTitle>

@if (!_ready)
{
    <div class="loading">
        <p>正在加载 Agent 列表...</p>
    </div>
}
else
{
    <h1>Agent 配置</h1>

    @if (_agents.Count == 0)
    {
        <p class="empty-state">暂无 Agent 数据。</p>
    }
    else
    {
        <div class="agents-grid">
            @foreach (var agent in _agents)
            {
                <section class="card agent-card">
                    <div class="agent-header">
                        <div class="agent-icon">🤖</div>
                        <div class="agent-title">
                            <h2>@agent.AgentName</h2>
                            <code class="agent-id">@agent.AgentId</code>
                        </div>
                    </div>
                    <div class="agent-body">
                        <div class="agent-info-row">
                            <span class="agent-info-label">地址：</span>
                            <span class="agent-info-value">@agent.IpAddress:@agent.Port</span>
                        </div>
                        <div class="agent-info-row">
                            <span class="agent-info-label">状态：</span>
                            <span class="status-badge @GetAgentStatusBadgeClass(agent.Status)">@GetAgentStatusLabel(agent.Status)</span>
                        </div>
                        <div class="agent-info-row">
                            <span class="agent-info-label">任务数：</span>
                            <span class="agent-info-value">@agent.TaskCount</span>
                        </div>
                        <div class="agent-info-row">
                            <span class="agent-info-label">最后心跳：</span>
                            <span class="agent-info-value">@agent.LastHeartbeat</span>
                        </div>
                    </div>
                </section>
            }
        </div>
    }
}

@code {
    private bool _ready;
    private List<AgentDto> _agents = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/admin/login", replace: true);
            return;
        }

        _agents = await ApiClient.GetAgentsAsync();
        _ready = true;
    }

    private static string GetAgentStatusBadgeClass(int status)
    {
        return status switch
        {
            1 => "running",
            2 => "idle",
            0 => "pending",
            _ => "error"
        };
    }

    private static string GetAgentStatusLabel(int status)
    {
        return status switch
        {
            0 => "离线",
            1 => "在线",
            2 => "空闲",
            _ => $"未知({status})"
        };
    }
}
