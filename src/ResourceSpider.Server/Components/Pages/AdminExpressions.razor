@page "/admin/expressions"
@using Microsoft.JSInterop
@layout AdminLayout
@implements IAsyncDisposable
@inject AdminSessionState Session
@inject AdminApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject ResourceSpider.Server.Components.Services.AdminNotificationService NotificationService

<PageTitle>表达式配置</PageTitle>

@if (!_ready)
{
    <p>正在加载表达式列表...</p>
}
else
{
    <h1>表达式配置</h1>

    <div class="action-row">
        <button id="expression-create-button" class="btn" type="button" @onclick="OpenCreateDrawer">新增表达式</button>
        <button class="btn btn-secondary" type="button" @onclick="InvalidateExpressionsAsync">使失效表达式过期</button>
        <button class="btn btn-secondary" type="button" @onclick="SearchAsync">刷新</button>
    </div>

    <section class="card runtime-section">
        <h2>查询过滤</h2>
        <div class="filter-row">
            <input class="input" placeholder="关键字（名称/描述/ID）" @bind="_keyword" />
            <select class="input" @bind="_statusFilter">
                <option value="-1">全部状态</option>
                <option value="0">草稿/未启用</option>
                <option value="1">启用</option>
                <option value="2">失效</option>
            </select>
            <select class="input" @bind="_pageSize">
                <option value="10">10 / 页</option>
                <option value="20">20 / 页</option>
                <option value="50">50 / 页</option>
            </select>
            <button class="btn" type="button" @onclick="SearchAsync">查询</button>
        </div>
    </section>

    <section class="card runtime-section">
        <h2>表达式列表</h2>

        @if (_expressions.Count == 0)
        {
            <p>暂无表达式数据。</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>名称</th>
                        <th>选择器类型</th>
                        <th>状态</th>
                        <th>字段数</th>
                        <th>成功/失败</th>
                        <th>创建时间</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expression in _expressions)
                    {
                        <tr>
                            @if (_editingExpressionId == expression.ExpressionId)
                            {
                                <td><input class="input" @bind="_editName" /></td>
                                <td>
                                    <select class="input" @bind="_editSelectorType">
                                        <option value="xpath">XPath</option>
                                        <option value="cssselector">CSS Selector</option>
                                        <option value="regex">正则表达式</option>
                                        <option value="jsonpath">JSON Path</option>
                                    </select>
                                </td>
                                <td>
                                    <select class="input" @bind="_editStatus">
                                        <option value="0">草稿/未启用</option>
                                        <option value="1">启用</option>
                                        <option value="2">失效</option>
                                    </select>
                                </td>
                                <td>@expression.Fields.Count</td>
                                <td>@expression.SuccessCount / @expression.FailureCount</td>
                                <td>@expression.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <div class="table-actions">
                                        <button class="btn" type="button" @onclick="SaveExpressionAsync">保存</button>
                                        <button class="btn btn-secondary" type="button" @onclick="CancelEdit">取消</button>
                                    </div>
                                </td>
                            }
                            else
                            {
                                <td>@expression.Name</td>
                                <td>@expression.SelectorType</td>
                                <td>@GetExpressionStatusLabel(expression.Status)</td>
                                <td>@expression.Fields.Count</td>
                                <td>@expression.SuccessCount / @expression.FailureCount</td>
                                <td>@expression.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <div class="table-actions">
                                        <button class="btn btn-secondary" type="button" @onclick="() => ShowDetailAsync(expression)">详情</button>
                                        <button class="btn btn-secondary" type="button" @onclick="() => BeginEdit(expression)">编辑</button>
                                        @if (_confirmDeleteExpressionId == expression.ExpressionId)
                                        {
                                            <button class="btn btn-danger" type="button" @onclick="() => DeleteExpressionAsync(expression.ExpressionId)">确认删除</button>
                                            <button class="btn btn-secondary" type="button" @onclick="CancelDelete">取消</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-danger" type="button" @onclick="() => PrepareDelete(expression.ExpressionId)">删除</button>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="pagination-row">
            <span>总数：@_total 条，当前第 @_pageIndex / @TotalPages 页</span>
            <div class="table-actions">
                <button class="btn btn-secondary" type="button" disabled="@(_pageIndex <= 1)" @onclick="PrevPageAsync">上一页</button>
                <button class="btn btn-secondary" type="button" disabled="@(_pageIndex >= TotalPages)" @onclick="NextPageAsync">下一页</button>
            </div>
            <div class="page-jump">
                <span>跳转到</span>
                <input class="input" type="number" min="1" max="@TotalPages" @bind="_jumpPageIndex" />
                <button class="btn btn-secondary" type="button" @onclick="JumpPageAsync">GO</button>
            </div>
        </div>
    </section>

    @if (_showCreateDrawer)
    {
        <div class="drawer-mask" @onclick="CloseCreateDrawer">
            <aside class="drawer-panel" @onclick:stopPropagation="true">
                <div class="drawer-header">
                    <h2>新增表达式</h2>
                    <button class="btn btn-secondary" type="button" @onclick="CloseCreateDrawer">关闭</button>
                </div>
                <div class="drawer-body">
                    <input class="input" placeholder="表达式名称" @bind="_newName" />
                    <select class="input" @bind="_newSelectorType">
                        <option value="xpath">XPath</option>
                        <option value="cssselector">CSS Selector</option>
                        <option value="regex">正则表达式</option>
                        <option value="jsonpath">JSON Path</option>
                    </select>
                    <input class="input" placeholder="描述（可选）" @bind="_newDescription" />
                    <input class="input" placeholder="容器表达式（可选）" @bind="_newContainerExpression" />
                    <div class="action-row">
                        <button class="btn" type="button" @onclick="CreateExpressionAsync">确认新增</button>
                        <button class="btn btn-secondary" type="button" @onclick="CloseCreateDrawer">取消</button>
                    </div>
                </div>
            </aside>
        </div>
    }

    @if (_showDetailDrawer && _detailExpression != null)
    {
        <div class="drawer-mask" @onclick="CloseDetailDrawer">
            <aside class="drawer-panel drawer-panel-wide" @onclick:stopPropagation="true">
                <div class="drawer-header">
                    <h2>表达式详情</h2>
                    <button class="btn btn-secondary" type="button" @onclick="CloseDetailDrawer">关闭</button>
                </div>
                <div class="drawer-body">
                    <div class="detail-group">
                        <label class="detail-label">表达式 ID</label>
                        <div class="detail-value"><code>@_detailExpression.ExpressionId</code></div>
                    </div>
                    <div class="detail-group">
                        <label class="detail-label">名称</label>
                        <div class="detail-value">@_detailExpression.Name</div>
                    </div>
                    <div class="detail-group">
                        <label class="detail-label">描述</label>
                        <div class="detail-value">@(_detailExpression.Description ?? "-")</div>
                    </div>
                    <div class="detail-group">
                        <label class="detail-label">选择器类型</label>
                        <div class="detail-value">@_detailExpression.SelectorType</div>
                    </div>
                    <div class="detail-group">
                        <label class="detail-label">容器表达式</label>
                        <div class="detail-value"><code>@(_detailExpression.ContainerExpression ?? "-")</code></div>
                    </div>
                    <div class="detail-group">
                        <label class="detail-label">状态</label>
                        <div class="detail-value">@GetExpressionStatusLabel(_detailExpression.Status)</div>
                    </div>
                    <div class="detail-group">
                        <label class="detail-label">成功/失败/连续失败</label>
                        <div class="detail-value">@_detailExpression.SuccessCount / @_detailExpression.FailureCount / @_detailExpression.ConsecutiveFailures</div>
                    </div>

                    <h3 style="margin-top:1rem;">字段列表 (@_detailExpression.Fields.Count)</h3>
                    @if (_detailExpression.Fields.Count == 0)
                    {
                        <p>无字段配置。</p>
                    }
                    else
                    {
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>字段名</th>
                                    <th>选择器类型</th>
                                    <th>表达式</th>
                                    <th>属性名</th>
                                    <th>必填</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var field in _detailExpression.Fields)
                                {
                                    <tr>
                                        <td>@field.FieldName</td>
                                        <td>@field.SelectorType</td>
                                        <td><code>@field.Expression</code></td>
                                        <td>@(field.AttributeName ?? "-")</td>
                                        <td>@(field.IsRequired ? "是" : "否")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </aside>
        </div>
    }
}

@code {
    private bool _ready;
    private bool _showCreateDrawer;
    private bool _showDetailDrawer;
    private List<ExpressionDto> _expressions = new();
    private ExpressionDto? _detailExpression;
    private string _message = string.Empty;

    private string _newName = string.Empty;
    private string _newSelectorType = "xpath";
    private string _newDescription = string.Empty;
    private string _newContainerExpression = string.Empty;

    private string? _editingExpressionId;
    private string _editName = string.Empty;
    private string _editSelectorType = string.Empty;
    private string _editDescription = string.Empty;
    private string _editContainerExpression = string.Empty;
    private int _editStatus = 1;

    private string? _confirmDeleteExpressionId;

    private int _pageIndex = 1;
    private int _pageSize = 20;
    private int _total;
    private int _statusFilter = -1;
    private string _keyword = string.Empty;
    private int _jumpPageIndex = 1;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/admin/login", replace: true);
            return;
        }

        LoadFiltersFromUri();
        await LoadPageAsync(updateUri: false);
        _ready = true;
    }

    private void OpenCreateDrawer()
    {
        _showCreateDrawer = true;
    }

    private void CloseCreateDrawer()
    {
        _showCreateDrawer = false;
    }

    private void LoadFiltersFromUri()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("page", out var pageValue)
            && int.TryParse(pageValue, out var pageParsed)
            && pageParsed > 0)
        {
            _pageIndex = pageParsed;
        }

        if (query.TryGetValue("pageSize", out var pageSizeValue)
            && int.TryParse(pageSizeValue, out var pageSizeParsed)
            && (pageSizeParsed == 10 || pageSizeParsed == 20 || pageSizeParsed == 50))
        {
            _pageSize = pageSizeParsed;
        }

        if (query.TryGetValue("status", out var statusValue)
            && int.TryParse(statusValue, out var statusParsed)
            && (statusParsed == -1 || statusParsed == 0 || statusParsed == 1 || statusParsed == 2))
        {
            _statusFilter = statusParsed;
        }

        if (query.TryGetValue("keyword", out var keywordValue))
        {
            _keyword = keywordValue.ToString();
        }
    }

    private void SyncUri()
    {
        var target = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = _pageIndex,
            ["pageSize"] = _pageSize,
            ["status"] = _statusFilter,
            ["keyword"] = string.IsNullOrWhiteSpace(_keyword) ? null : _keyword.Trim()
        });

        Navigation.NavigateTo(target, replace: true);
    }

    private async Task LoadPageAsync(bool updateUri = true)
    {
        int? status = _statusFilter < 0 ? null : _statusFilter;
        var keyword = string.IsNullOrWhiteSpace(_keyword) ? null : _keyword.Trim();
        var response = await ApiClient.GetExpressionsAsync(_pageIndex, _pageSize, status, keyword);

        _expressions = response?.Expressions ?? new List<ExpressionDto>();
        _total = response?.Total ?? 0;

        if (_pageIndex > TotalPages)
        {
            _pageIndex = TotalPages;
            await LoadPageAsync(updateUri);
            return;
        }

        _jumpPageIndex = _pageIndex;

        if (updateUri)
        {
            SyncUri();
        }
    }

    private async Task SearchAsync()
    {
        _pageIndex = 1;
        await LoadPageAsync();
    }

    private async Task PrevPageAsync()
    {
        if (_pageIndex <= 1)
        {
            return;
        }

        _pageIndex--;
        await LoadPageAsync();
    }

    private async Task NextPageAsync()
    {
        if (_pageIndex >= TotalPages)
        {
            return;
        }

        _pageIndex++;
        await LoadPageAsync();
    }

    private async Task JumpPageAsync()
    {
        if (_jumpPageIndex < 1 || _jumpPageIndex > TotalPages)
        {
            NotificationService.Warning("页码无效", $"页码范围应为 1 到 {TotalPages}。");
            return;
        }

        _pageIndex = _jumpPageIndex;
        await LoadPageAsync();
    }

    private async Task CreateExpressionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newSelectorType))
        {
            NotificationService.Warning("新增失败", "表达式名称和选择器类型不能为空。");
            return;
        }

        var (success, message) = await ApiClient.CreateExpressionAsync(new CreateExpressionRequest(
            _newName.Trim(),
            string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription.Trim(),
            _newSelectorType.Trim(),
            string.IsNullOrWhiteSpace(_newContainerExpression) ? null : _newContainerExpression.Trim(),
            null));

        if (!success)
        {
            NotificationService.Error("新增失败", message);
            return;
        }

        NotificationService.Success("新增成功", string.IsNullOrWhiteSpace(message) ? "表达式已创建。" : message);
        _newName = string.Empty;
        _newSelectorType = "xpath";
        _newDescription = string.Empty;
        _newContainerExpression = string.Empty;
        _showCreateDrawer = false;
        await SearchAsync();
    }

    private void BeginEdit(ExpressionDto expression)
    {
        _editingExpressionId = expression.ExpressionId;
        _editName = expression.Name;
        _editSelectorType = expression.SelectorType;
        _editDescription = expression.Description;
        _editContainerExpression = expression.ContainerExpression;
        _editStatus = expression.Status;
        _confirmDeleteExpressionId = null;
    }

    private void CancelEdit()
    {
        _editingExpressionId = null;
    }

    private async Task SaveExpressionAsync()
    {
        if (string.IsNullOrWhiteSpace(_editingExpressionId))
        {
            return;
        }

        var (success, message) = await ApiClient.UpdateExpressionAsync(_editingExpressionId, new UpdateExpressionRequest(
            _editName,
            string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription,
            _editSelectorType,
            string.IsNullOrWhiteSpace(_editContainerExpression) ? null : _editContainerExpression,
            _editStatus,
            null));

        if (!success)
        {
            NotificationService.Error("保存失败", message);
            return;
        }

        NotificationService.Success("保存成功", string.IsNullOrWhiteSpace(message) ? "表达式已更新。" : message);
        CancelEdit();
        await LoadPageAsync();
    }

    private void PrepareDelete(string expressionId)
    {
        _confirmDeleteExpressionId = expressionId;
        _editingExpressionId = null;
    }

    private void CancelDelete()
    {
        _confirmDeleteExpressionId = null;
    }

    private async Task DeleteExpressionAsync(string expressionId)
    {
        var (success, message) = await ApiClient.DeleteExpressionAsync(expressionId);
        if (!success)
        {
            NotificationService.Error("删除失败", message);
            return;
        }

        NotificationService.Success("删除成功", string.IsNullOrWhiteSpace(message) ? "表达式已删除。" : message);
        _confirmDeleteExpressionId = null;
        await LoadPageAsync();
    }

    private static string GetExpressionStatusLabel(int status)
    {
        return status switch
        {
            0 => "草稿/未启用",
            1 => "启用",
            2 => "失效",
            _ => $"未知({status})"
        };
    }

    private void ShowDetailAsync(ExpressionDto expression)
    {
        _detailExpression = expression;
        _showDetailDrawer = true;
    }

    private void CloseDetailDrawer()
    {
        _showDetailDrawer = false;
        _detailExpression = null;
    }

    private async Task InvalidateExpressionsAsync()
    {
        var (success, message) = await ApiClient.InvalidateExpressionsAsync();
        if (success)
            NotificationService.Success("操作成功", string.IsNullOrWhiteSpace(message) ? "失效表达式已处理。" : message);
        else
            NotificationService.Error("操作失败", message);
        await LoadPageAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JsRuntime.InvokeVoidAsync("drawerUx.syncState", _showCreateDrawer ? "expression-create-button" : null);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("drawerUx.forceClose");
        }
        catch
        {
        }
    }
}
