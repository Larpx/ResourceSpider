@page "/admin"
@layout AdminLayout
@inject AdminSessionState Session
@inject AdminApiClient ApiClient
@inject NavigationManager Navigation
@inject ResourceSpider.Server.Components.Services.AdminNotificationService NotificationService

<PageTitle>后台首页 - ResourceSpider</PageTitle>

@if (!_ready)
{
    <div class="loading">
        <p>正在加载后台信息...</p>
    </div>
}
else
{
    <h1>后台管理首页</h1>

    <div class="admin-stats-grid">
        @if (_statistics != null)
        {
            <div class="admin-stat-card">
                <div class="admin-stat-value">@_statistics.OnlineAgents / @_statistics.TotalAgents</div>
                <div class="admin-stat-label">在线 Agent</div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-value">@_statistics.RunningTasks</div>
                <div class="admin-stat-label">运行中任务</div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-value">@_statistics.PendingTasks</div>
                <div class="admin-stat-label">待执行任务</div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-value">@_statistics.CompletedTasks</div>
                <div class="admin-stat-label">已完成任务</div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-value">@_statistics.TotalDataVolume</div>
                <div class="admin-stat-label">总数据量</div>
            </div>
        }
    </div>

    <div class="admin-panel">
        <div class="admin-panel-header">
            <h2 class="admin-panel-title">系统健康</h2>
        </div>
        <div class="admin-panel-body">
            @if (_health != null)
            {
                <p>状态：<strong class="health-status">@_health.Status</strong></p>
                <p>版本：@_health.Version</p>
                <p>运行时长：@_health.Uptime</p>
            }
        </div>
    </div>

    <div class="admin-panel">
        <div class="admin-panel-header">
            <h2 class="admin-panel-title">管理入口</h2>
        </div>
        <div class="admin-panel-body">
            <div class="admin-link-grid">
                <a class="admin-link-item" href="/admin/agents">
                    <span class="admin-link-icon">🤖</span>
                    <span class="admin-link-text">Agent 配置</span>
                </a>
                <a class="admin-link-item" href="/admin/tasks">
                    <span class="admin-link-icon">📋</span>
                    <span class="admin-link-text">任务配置</span>
                </a>
                <a class="admin-link-item" href="/admin/expressions">
                    <span class="admin-link-icon">🔧</span>
                    <span class="admin-link-text">表达式配置</span>
                </a>
                <a class="admin-link-item" href="/admin/proxies">
                    <span class="admin-link-icon">🌐</span>
                    <span class="admin-link-text">代理池配置</span>
                </a>
                <a class="admin-link-item" href="/admin/system">
                    <span class="admin-link-icon">⚙️</span>
                    <span class="admin-link-text">系统配置</span>
                </a>
                <a class="admin-link-item" href="/admin/runtime">
                    <span class="admin-link-icon">📈</span>
                    <span class="admin-link-text">运行监控</span>
                </a>
            </div>
        </div>
    </div>
}

@code {
    private bool _ready;
    private SystemStatisticsDto? _statistics;
    private SystemHealthDto? _health;
    private bool _shouldRedirectToLogin;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            _shouldRedirectToLogin = true;
            return;
        }

        _statistics = await ApiClient.GetSystemStatisticsAsync();
        _health = await ApiClient.GetSystemHealthAsync();
        _ready = true;

        if (_statistics == null || _health == null)
        {
            NotificationService.Warning("部分数据未加载", "后台首页存在部分统计或健康信息未成功获取。");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _shouldRedirectToLogin)
        {
            Navigation.NavigateTo("/admin/login", replace: true);
        }
    }
}
