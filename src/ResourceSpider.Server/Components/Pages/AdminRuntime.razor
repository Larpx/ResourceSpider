@page "/admin/runtime"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@layout AdminLayout
@implements IAsyncDisposable
@inject AdminSessionState Session
@inject AdminApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject Larpx.PersonalTools.ResourceSpider.Server.Components.Services.AdminNotificationService NotificationService

<PageTitle>运行监控</PageTitle>

<h1>运行监控</h1>

@if (!_ready)
{
    <p>正在加载运行状态...</p>
}
else if (_runtime == null)
{
    <p>暂未获取到运行状态。</p>
}
else
{
    <div class="action-row">
        <button class="btn" type="button" @onclick="HandleManualRefreshAsync">立即刷新</button>
        <label class="inline-setting">
            推送策略
            <select class="input interval-select" @bind="_selectedPushIntervalSeconds" @bind:after="OnPushIntervalChangedAsync">
                <option value="1">1 秒</option>
                <option value="2">2 秒</option>
                <option value="5">5 秒</option>
            </select>
        </label>
        <span class="refresh-badge">实时推送：@(_runtimeConnection?.State == HubConnectionState.Connected ? "已连接" : "未连接")，最近更新：@_lastRefreshedAtText</span>
        <a class="btn btn-secondary" href="/admin/system">返回系统配置</a>
    </div>

    <div class="card-grid">
        <section class="card">
            <h2>服务状态</h2>
            <p>状态：<strong>@_runtime.Status</strong></p>
            <p>环境：@_runtime.Environment</p>
            <p>版本：@_runtime.Version</p>
            <p>机器名：@_runtime.MachineName</p>
            <p>进程 ID：@_runtime.ProcessId</p>
            <p>运行时：@_runtime.Framework</p>
            <p>系统：@_runtime.OsDescription</p>
            <p>运行时长：@_runtime.Uptime</p>
            <p>采样时间(UTC)：@_runtime.TimestampUtc.ToString("u")</p>
        </section>

        <section class="card">
            <h2>当前负载</h2>
            <ul>
                <li>CPU：@_runtime.CurrentLoad.CpuLoadPercent%</li>
                <li>工作集内存：@_runtime.CurrentLoad.WorkingSetMb MB</li>
                <li>托管堆内存：@_runtime.CurrentLoad.GcHeapMb MB</li>
                <li>线程池：@_runtime.CurrentLoad.ThreadPoolAvailableWorkers / @_runtime.CurrentLoad.ThreadPoolMaxWorkers</li>
                <li>待处理工作项：@_runtime.CurrentLoad.PendingWorkItems</li>
            </ul>
        </section>

        <section class="card">
            <h2>Agent 负载概览</h2>
            <ul>
                <li>总数：@_runtime.AgentLoad.TotalAgents</li>
                <li>在线：@_runtime.AgentLoad.OnlineAgents</li>
                <li>忙碌：@_runtime.AgentLoad.BusyAgents</li>
                <li>执行中任务：@_runtime.AgentLoad.TotalRunningTasks</li>
                <li>平均 CPU：@_runtime.AgentLoad.AverageCpuUsage%</li>
                <li>平均内存：@_runtime.AgentLoad.AverageMemoryUsage%</li>
            </ul>
        </section>
    </div>

    <section class="card runtime-section">
        <h2>Agent 实时状态（最多 20 条）</h2>
        @if (_runtime.Agents.Count == 0)
        {
            <p>暂无 Agent 状态。</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>AgentId</th>
                        <th>名称</th>
                        <th>状态</th>
                        <th>CPU(%)</th>
                        <th>内存(%)</th>
                        <th>任务数</th>
                        <th>最后心跳</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agent in _runtime.Agents)
                    {
                        <tr>
                            <td>@agent.AgentId</td>
                            <td>@agent.AgentName</td>
                            <td>@agent.Status</td>
                            <td>@(agent.CpuUsage?.ToString("0.##") ?? "-")</td>
                            <td>@(agent.MemoryUsage?.ToString("0.##") ?? "-")</td>
                            <td>@agent.TaskCount</td>
                            <td>@(agent.LastHeartbeat?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="card runtime-section">
        <h2>系统日志（数据库）</h2>
        @if (_runtime.RecentLogs.Count == 0)
        {
            <p>暂无系统日志。</p>
        }
        else
        {
            <ul>
                @foreach (var log in _runtime.RecentLogs)
                {
                    <li>[@log.CreatedAt.ToLocalTime().ToString("HH:mm:ss")] [@log.Level] (@log.Category) @log.Message</li>
                }
            </ul>
        }
    </section>

    <section class="card runtime-section">
        <h2>程序输出（SignalR 推送，最多 1000 条滚动）</h2>
        @if (_runtime.RuntimeOutputLogs.Count == 0)
        {
            <p>暂无程序输出。</p>
        }
        else
        {
            <div id="runtime-output-box" class="log-box runtime-output-box">
                @foreach (var output in _runtime.RuntimeOutputLogs)
                {
                    <div class="runtime-output-line">[@output.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")] [@output.Level] (@output.Source) @output.Message</div>
                }
            </div>
        }
    </section>
}

@code {
    private bool _ready;
    private bool _loading;
    private string _lastRefreshedAtText = "-";
    private SystemRuntimeStatusDto? _runtime;
    private HubConnection? _runtimeConnection;
    private int _selectedPushIntervalSeconds = 1;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/admin/login", replace: true);
            return;
        }

        await LoadAsync();
        await ConnectRuntimeStreamAsync();
        _ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_runtime?.RuntimeOutputLogs.Count > 0)
        {
            await JsRuntime.InvokeVoidAsync("runtimeLogScroller.scrollToBottom", "runtime-output-box");
        }
    }

    private async Task ConnectRuntimeStreamAsync()
    {
        _runtimeConnection = await ApiClient.ConnectRuntimeStreamAsync(
            async snapshot =>
            {
                await InvokeAsync(() =>
                {
                    _runtime = snapshot;
                    _lastRefreshedAtText = DateTime.Now.ToString("HH:mm:ss");
                    StateHasChanged();
                    return Task.CompletedTask;
                });
            },
            async log =>
            {
                await InvokeAsync(() =>
                {
                    if (_runtime == null)
                    {
                        return Task.CompletedTask;
                    }

                    var logs = _runtime.RuntimeOutputLogs;
                    if (logs.Count > 0 && logs[^1].Sequence >= log.Sequence)
                    {
                        return Task.CompletedTask;
                    }

                    logs.Add(log);
                    if (logs.Count > 1000)
                    {
                        logs.RemoveRange(0, logs.Count - 1000);
                    }

                    _lastRefreshedAtText = DateTime.Now.ToString("HH:mm:ss");
                    StateHasChanged();
                    return Task.CompletedTask;
                });
            });

        if (_runtimeConnection != null)
        {
            _selectedPushIntervalSeconds = await ApiClient.SetRuntimeSnapshotIntervalAsync(_runtimeConnection, _selectedPushIntervalSeconds);
        }
    }

    private async Task OnPushIntervalChangedAsync()
    {
        if (_runtimeConnection == null || _runtimeConnection.State != HubConnectionState.Connected)
        {
            NotificationService.Warning("切换失败", "实时连接未建立，无法更新推送策略。");
            return;
        }

        _selectedPushIntervalSeconds = await ApiClient.SetRuntimeSnapshotIntervalAsync(_runtimeConnection, _selectedPushIntervalSeconds);
        NotificationService.Info("推送策略已更新", $"当前快照推送间隔：{_selectedPushIntervalSeconds} 秒。");
    }

    private async Task HandleManualRefreshAsync()
    {
        await LoadAsync();
        NotificationService.Success("刷新成功", "运行监控数据已手动刷新。");
    }

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        try
        {
            _runtime = await ApiClient.GetSystemRuntimeStatusAsync();
            _lastRefreshedAtText = DateTime.Now.ToString("HH:mm:ss");
        }
        finally
        {
            _loading = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_runtimeConnection != null)
        {
            try
            {
                await _runtimeConnection.InvokeAsync("LeaveAdminRuntimeGroup");
                await _runtimeConnection.DisposeAsync();
            }
            catch
            {
            }
        }
    }
}
