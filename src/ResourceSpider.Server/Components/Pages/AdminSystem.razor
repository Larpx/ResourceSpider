@page "/admin/system"
@layout AdminLayout
@inject AdminSessionState Session
@inject AdminApiClient ApiClient
@inject NavigationManager Navigation
@inject Larpx.PersonalTools.ResourceSpider.Server.Components.Services.AdminNotificationService NotificationService

<PageTitle>系统配置</PageTitle>

@if (!_ready)
{
    <p>正在加载系统信息...</p>
}
else
{
    <h1>系统配置</h1>

    <div class="action-row">
        <button class="btn" type="button" @onclick="RefreshFromButtonAsync">刷新健康状态</button>
        <a class="btn btn-secondary" href="/admin/runtime">打开运行监控页</a>
    </div>

    <div class="card-grid">
        <section class="card">
            <h2>系统健康</h2>
            @if (_health == null)
            {
                <p>暂无健康数据。</p>
            }
            else
            {
                <p>状态：<strong>@_health.Status</strong></p>
                <p>环境：@(_health.Environment ?? "N/A")</p>
                <p>版本：@_health.Version</p>
                <p>运行时长：@_health.Uptime</p>
                <p>启动时间(UTC)：@(_health.StartedAtUtc?.ToString("u") ?? "N/A")</p>
                <p>采样时间(UTC)：@(_health.TimestampUtc?.ToString("u") ?? "N/A")</p>
            }
        </section>

        <section class="card">
            <h2>服务负载</h2>
            @if (_health?.Load == null)
            {
                <p>暂无负载数据。</p>
            }
            else
            {
                <ul>
                    <li>CPU：@_health.Load.CpuLoadPercent%</li>
                    <li>工作集内存：@_health.Load.WorkingSetMb MB</li>
                    <li>托管堆内存：@_health.Load.GcHeapMb MB</li>
                    <li>线程池：@_health.Load.ThreadPoolAvailableWorkers / @_health.Load.ThreadPoolMaxWorkers</li>
                    <li>待处理工作项：@_health.Load.PendingWorkItems</li>
                </ul>
            }
        </section>

        <section class="card">
            <h2>依赖组件状态</h2>
            @if (_health?.Components == null || _health.Components.Count == 0)
            {
                <p>暂无组件状态。</p>
            }
            else
            {
                <ul>
                    @foreach (var component in _health.Components)
                    {
                        <li>@component.Key：@component.Value</li>
                    }
                </ul>
            }
        </section>

        <section class="card">
            <h2>Redis 配置</h2>
            @if (_redisStatus == null)
            {
                <p>暂无 Redis 状态。</p>
            }
            else
            {
                <p>状态：<strong>@_redisStatus.Status</strong></p>
                <p>配置存在：@(_redisStatus.Configured ? "是" : "否")</p>
                <p>连接状态：@(_redisStatus.Connected ? "已连接" : "未连接")</p>
                <p>任务缓存 TTL：@_redisStatus.TaskContentTtlSeconds 秒</p>
                <button class="btn btn-secondary" type="button" @onclick="ToggleRedisAsync">
                    @(_redisStatus.Enabled ? "停用 Redis" : "启用 Redis")
                </button>
            }
        </section>

        <section class="card">
            <h2>最近日志</h2>
            @if (_logs.Count == 0)
            {
                <p>暂无日志数据。</p>
            }
            else
            {
                <ul>
                    @foreach (var log in _logs)
                    {
                        <li>[@log.Level] @log.Message</li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    private bool _ready;
    private SystemHealthDto? _health;
    private RedisFeatureStatusDto? _redisStatus;
    private List<SystemLogDto> _logs = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/admin/login", replace: true);
            return;
        }

        await RefreshAsync(showNotification: false);
        _ready = true;
    }

    private Task RefreshFromButtonAsync()
    {
        return RefreshAsync();
    }

    private async Task RefreshAsync(bool showNotification = true)
    {
        _health = await ApiClient.GetSystemHealthAsync();
        _redisStatus = await ApiClient.GetRedisFeatureStatusAsync();
        var logsResponse = await ApiClient.GetSystemLogsAsync();
        _logs = logsResponse?.Logs ?? new List<SystemLogDto>();

        if (showNotification)
        {
            NotificationService.Success("刷新成功", "系统配置与健康状态已更新。");
        }
    }

    private async Task ToggleRedisAsync()
    {
        if (_redisStatus == null)
        {
            NotificationService.Warning("操作失败", "当前暂无 Redis 状态可供切换。");
            return;
        }

        var targetEnabled = !_redisStatus.Enabled;
        _redisStatus = await ApiClient.UpdateRedisFeatureStatusAsync(targetEnabled) ?? _redisStatus;
        _health = await ApiClient.GetSystemHealthAsync();
        NotificationService.Success("Redis 开关已更新", targetEnabled ? "已启用 Redis 功能。" : "已停用 Redis 功能。");
    }
}
