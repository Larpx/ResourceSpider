@page "/admin/login"
@inject AdminApiClient ApiClient
@inject AdminSessionState Session
@inject NavigationManager Navigation

<PageTitle>登录 - ResourceSpider</PageTitle>

<div class="login-page">
    <div class="login-background">
        <div class="login-grid-line line-1"></div>
        <div class="login-grid-line line-2"></div>
        <div class="login-grid-line line-3"></div>
        <div class="login-circle circle-1"></div>
        <div class="login-circle circle-2"></div>
    </div>

    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="login-logo">
                    <span class="logo-icon">⬡</span>
                </div>
                <h1 class="login-title">ResourceSpider</h1>
                <p class="login-subtitle">后台管理系统</p>
            </div>

            <EditForm Model="_model" OnValidSubmit="HandleLoginAsync" class="login-form">
                <DataAnnotationsValidator />
                
                <div class="form-group">
                    <label for="username" class="form-label">用户名</label>
                    <InputText id="username" class="form-input" @bind-Value="_model.Username" placeholder="请输入用户名" />
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">密码</label>
                    <InputText id="password" class="form-input" type="password" @bind-Value="_model.Password" placeholder="请输入密码" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="error-alert">
                        <span class="error-icon">⚠</span>
                        <span>@_errorMessage</span>
                    </div>
                }

                <button type="submit" class="login-button" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="loading-spinner"></span>
                        <span>登录中...</span>
                    }
                    else
                    {
                        <span>登 录</span>
                    }
                </button>
            </EditForm>

            <div class="login-footer">
                <a href="/welcome">返回首页</a>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginFormModel _model = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/admin", replace: true);
        }
    }

    private async Task HandleLoginAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        var (success, message) = await ApiClient.LoginAsync(_model.Username, _model.Password);
        _isSubmitting = false;

        if (!success)
        {
            _errorMessage = message;
            return;
        }

        Navigation.NavigateTo("/admin", replace: true);
    }

    private sealed class LoginFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
