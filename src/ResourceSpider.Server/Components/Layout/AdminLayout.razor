@inherits LayoutComponentBase
@implements IDisposable
@inject AdminSessionState Session
@inject AdminApiClient ApiClient
@inject NavigationManager Navigation
@inject Larpx.PersonalTools.ResourceSpider.Server.Components.Services.AdminNotificationService NotificationService

<div class="admin-app">
    <header class="admin-topbar">
        <div class="admin-topbar-left">
            <button class="sidebar-toggle" @onclick="ToggleSidebar" title="折叠菜单">
                <span class="toggle-icon">@(_sidebarCollapsed ? "☰" : "✕")</span>
            </button>
            <div class="admin-logo">
                <span class="logo-symbol">⬡</span>
                <span class="logo-text">ResourceSpider</span>
            </div>
        </div>
        <div class="admin-topbar-right">
            <div class="status-indicator">
                <span class="status-dot online"></span>
                <span class="status-text">系统正常</span>
            </div>
            <div class="notification-container">
                <button class="topbar-btn" @onclick="ToggleNotificationPanel" title="通知">
                    <span>🔔</span>
                    <span class="notification-badge">@NotificationService.Items.Count</span>
                </button>
                @if (_notificationPanelExpanded)
                {
                    <div class="notification-panel">
                        <div class="notification-panel-header">
                            <strong>通知中心</strong>
                            <div class="table-actions">
                                <button class="btn btn-secondary btn-sm" type="button" @onclick="ToggleNotificationPanel">折叠</button>
                                <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearNotifications">清空</button>
                            </div>
                        </div>

                        <div class="notification-filter-row">
                            <button class="btn btn-secondary btn-sm" type="button" @onclick='() => SetNotificationFilter(string.Empty)'>全部</button>
                            <button class="btn btn-secondary btn-sm" type="button" @onclick='() => SetNotificationFilter("success")'>成功</button>
                            <button class="btn btn-secondary btn-sm" type="button" @onclick='() => SetNotificationFilter("info")'>信息</button>
                            <button class="btn btn-secondary btn-sm" type="button" @onclick='() => SetNotificationFilter("warning")'>警告</button>
                            <button class="btn btn-secondary btn-sm" type="button" @onclick='() => SetNotificationFilter("error")'>错误</button>
                        </div>

                        @if (!FilteredNotifications.Any())
                        {
                            <p class="empty-state">暂无通知。</p>
                        }
                        else
                        {
                            <div class="notification-list">
                                @foreach (var item in FilteredNotifications.Take(10))
                                {
                                    <div class="notification-item @item.Level">
                                        <div class="notification-item-header">
                                            <div class="notification-title-group">
                                                <span class="notification-icon">@GetNotificationIcon(item.Level)</span>
                                                <strong>@item.Title</strong>
                                                @if (item.RepeatCount > 1)
                                                {
                                                    <span class="notification-repeat-badge">x @item.RepeatCount</span>
                                                }
                                            </div>
                                            <button class="topbar-btn notification-close" @onclick="() => RemoveNotification(item.Id)" title="关闭">✕</button>
                                        </div>
                                        <div class="notification-item-message">@item.Message</div>
                                        <div class="notification-item-time">@item.CreatedAt.ToString("HH:mm:ss")</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="user-dropdown">
                <span class="user-avatar">@Session.Username?.Substring(0, 1).ToUpper()</span>
                <span class="user-name">@Session.Username</span>
                <button class="topbar-btn" @onclick="Logout" title="退出登录">退出</button>
            </div>
        </div>
    </header>

    <div class="admin-body">
        <aside class="admin-sidebar @(_sidebarCollapsed ? "collapsed" : "")">
            <nav class="sidebar-menu">
                <NavLink href="/admin" Match="NavLinkMatch.All" class="sidebar-menu-item">
                    <span class="menu-icon">📊</span>
                    <span class="menu-text">后台首页</span>
                </NavLink>
                <NavLink href="/admin/agents" class="sidebar-menu-item">
                    <span class="menu-icon">🤖</span>
                    <span class="menu-text">Agent管理</span>
                </NavLink>
                <NavLink href="/admin/agent-groups" class="sidebar-menu-item">
                    <span class="menu-icon">👥</span>
                    <span class="menu-text">Agent分组</span>
                </NavLink>
                <NavLink href="/admin/tasks" class="sidebar-menu-item">
                    <span class="menu-icon">📋</span>
                    <span class="menu-text">任务管理</span>
                </NavLink>
                <NavLink href="/admin/expressions" class="sidebar-menu-item">
                    <span class="menu-icon">🔧</span>
                    <span class="menu-text">表达式管理</span>
                </NavLink>
                <NavLink href="/admin/results" class="sidebar-menu-item">
                    <span class="menu-icon">📦</span>
                    <span class="menu-text">采集结果</span>
                </NavLink>
                <NavLink href="/admin/proxies" class="sidebar-menu-item">
                    <span class="menu-icon">🌐</span>
                    <span class="menu-text">代理管理</span>
                </NavLink>
                <div class="menu-divider"></div>
                <div class="menu-section-title">分析</div>
                <NavLink href="/admin/statistics" class="sidebar-menu-item">
                    <span class="menu-icon">📈</span>
                    <span class="menu-text">统计分析</span>
                </NavLink>
                <NavLink href="/admin/config" class="sidebar-menu-item">
                    <span class="menu-icon">🧪</span>
                    <span class="menu-text">配置工具</span>
                </NavLink>
                <div class="menu-divider"></div>
                <div class="menu-section-title">系统</div>
                <NavLink href="/admin/system" class="sidebar-menu-item">
                    <span class="menu-icon">⚙️</span>
                    <span class="menu-text">系统设置</span>
                </NavLink>
                <NavLink href="/admin/runtime" class="sidebar-menu-item">
                    <span class="menu-icon">�</span>
                    <span class="menu-text">运行监控</span>
                </NavLink>
            </nav>
        </aside>

        <main class="admin-workspace">
            <div class="admin-workspace-content">
                @Body
            </div>
            <footer class="admin-statusbar">
                <div class="statusbar-left">
                    <span>运行状态：<span class="status-ok">正常</span></span>
                    <span class="divider">|</span>
                    <span>最后更新：@_lastUpdate</span>
                </div>
                <div class="statusbar-right">
                    <span>ResourceSpider Admin v1.0</span>
                </div>
            </footer>
        </main>
    </div>
</div>

@code {
    private bool _sidebarCollapsed;
    private bool _notificationPanelExpanded;
    private string _notificationFilter = string.Empty;
    private string _lastUpdate = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");

    private IEnumerable<Larpx.PersonalTools.ResourceSpider.Server.Components.Services.AdminNotificationItem> FilteredNotifications =>
        string.IsNullOrWhiteSpace(_notificationFilter)
            ? NotificationService.Items
            : NotificationService.Items.Where(x => x.Level == _notificationFilter);

    protected override void OnInitialized()
    {
        Session.OnChange += HandleSessionChanged;
        NotificationService.OnChange += HandleSessionChanged;
    }

    private void ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
    }

    private void ToggleNotificationPanel()
    {
        _notificationPanelExpanded = !_notificationPanelExpanded;
    }

    private void SetNotificationFilter(string level)
    {
        _notificationFilter = level;
    }

    private void ClearNotifications()
    {
        NotificationService.Clear();
    }

    private void RemoveNotification(Guid id)
    {
        NotificationService.Remove(id);
    }

    private void Logout()
    {
        ApiClient.Logout();
        Navigation.NavigateTo("/welcome", replace: true);
    }

    private static string GetNotificationIcon(string level)
    {
        return level switch
        {
            "success" => "✅",
            "info" => "ℹ️",
            "warning" => "⚠️",
            "error" => "⛔",
            _ => "🔔"
        };
    }

    private void HandleSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
        NotificationService.OnChange -= HandleSessionChanged;
    }
}
