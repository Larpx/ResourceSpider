@inherits LayoutComponentBase
@implements IDisposable
@inject AdminSessionState Session
@inject AdminApiClient ApiClient
@inject NavigationManager Navigation

<div class="page">
    <header class="top-bar">
        <div class="brand">
            Resource<span>Spider</span>
        </div>
        <nav class="menu">
            <NavLink href="/welcome" Match="NavLinkMatch.All">欢迎</NavLink>
            <NavLink href="/overview">系统概览</NavLink>

            @if (Session.IsAuthenticated)
            {
                <NavLink href="/admin" Match="NavLinkMatch.All">后台首页</NavLink>
                <NavLink href="/admin/agents">Agent</NavLink>
                <NavLink href="/admin/tasks">任务</NavLink>
                <NavLink href="/admin/expressions">表达式</NavLink>
                <NavLink href="/admin/proxies">代理</NavLink>
                <NavLink href="/admin/system">系统</NavLink>
                <NavLink href="/admin/runtime">监控</NavLink>
                <button class="menu-button" type="button" @onclick="Logout">
                    <span>退出</span>
                </button>
            }
            else
            {
                <NavLink href="/admin/login">后台登录</NavLink>
            }

            <a href="/swagger" target="_blank" class="menu-external">API 文档</a>
            <a href="/health" target="_blank" class="menu-external">健康检查</a>
        </nav>
    </header>

    <main class="content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += HandleSessionChanged;
    }

    private void Logout()
    {
        ApiClient.Logout();
        Navigation.NavigateTo("/welcome", replace: true);
    }

    private void HandleSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }
}
