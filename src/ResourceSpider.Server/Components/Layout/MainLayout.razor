@inherits LayoutComponentBase
@implements IDisposable
@inject AdminSessionState Session
@inject AdminApiClient ApiClient
@inject NavigationManager Navigation

<div class="page">
    <header class="top-bar">
        <div class="brand">
            Resource<span>Spider</span>
        </div>
        <nav class="menu">
            <NavLink href="/welcome" Match="NavLinkMatch.All">欢迎</NavLink>
            <NavLink href="/overview">系统概览</NavLink>
            <a href="/swagger" target="_blank" class="menu-external">API 文档</a>
            <a href="/health" target="_blank" class="menu-external">健康检查</a>
        </nav>
        <div class="user-actions">
            @if (Session.IsAuthenticated)
            {
                <button class="menu-button" type="button" @onclick="Logout">退出</button>
            }
            else
            {
                <NavLink href="/admin/login" class="btn-login">后台登录</NavLink>
            }
        </div>
    </header>

    @if (Session.IsAuthenticated)
    {
        <div class="admin-layout">
            <aside class="admin-sidebar">
                <div class="sidebar-header">系统管理</div>
                <nav class="sidebar-nav">
                    <NavLink href="/admin" Match="NavLinkMatch.All">后台首页</NavLink>
                    <NavLink href="/admin/agents">Agent管理</NavLink>
                    <NavLink href="/admin/tasks">任务管理</NavLink>
                    <NavLink href="/admin/expressions">表达式管理</NavLink>
                    <NavLink href="/admin/proxies">代理管理</NavLink>
                    <NavLink href="/admin/system">系统设置</NavLink>
                    <NavLink href="/admin/runtime">运行监控</NavLink>
                </nav>
            </aside>
            <main class="content">
                @Body
            </main>
        </div>
    }
    else
    {
        <main class="content">
            @Body
        </main>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += HandleSessionChanged;
    }

    private void Logout()
    {
        ApiClient.Logout();
        Navigation.NavigateTo("/welcome", replace: true);
    }

    private void HandleSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }
}
