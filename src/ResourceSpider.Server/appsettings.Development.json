{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Redis": {
    "Enabled": false,
    "TaskContentTtlSeconds": 300
  },
  "RuntimeMonitoring": {
    "DefaultSnapshotPushIntervalSeconds": 1,
    "SnapshotPushIntervalsSeconds": [ 1, 2, 5 ]
  },
  "AllowedHosts": "*"
}
